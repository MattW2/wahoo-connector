# Wahoo API Credentials (from https://developers.wahooligan.com/applications)
WAHOO_CLIENT_ID=your_wahoo_client_id_here
WAHOO_CLIENT_SECRET=your_wahoo_client_secret_here
WAHOO_REDIRECT_URI=http://localhost:8080/callback

# Background Sync Interval (in minutes)
# Set to 60 for hourly sync, 15 for 15-minute sync, or 0 for one-shot exit mode
SYNC_INTERVAL_MINUTES=60

# Web Server Port (default: 8080)
PORT=8080
